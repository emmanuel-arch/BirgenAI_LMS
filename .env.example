# ── BirgenAI_LMS platform environment ─────────────────────────────────────────
# Per-LENDER secrets (Daraja, SMS, CRB, KYC, ServiceSuite conns) do NOT live
# here — they live encrypted per-org in OrgIntegration (the vault). This file
# holds platform-level config only.

# Dedicated Postgres (NOT the Hub's database)
DATABASE_URL="postgresql://user:pass@host:6543/birgenai_lms?pgbouncer=true"
# NOTE: on IPv4-only networks use the SESSION POOLER (aws-0-<region>.pooler.supabase.com:5432,
# username postgres.<ref>) as DIRECT_URL — the db.<ref>.supabase.co host is IPv6-only.
DIRECT_URL="postgresql://user:pass@host:5432/birgenai_lms"

# Auth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Vault master key (AES-256-GCM) for OrgIntegration.configEnc — 32 bytes hex.
# Rotate via re-encryption job; never log.
VAULT_MASTER_KEY=""

# Private object storage for KYC images (borrower ID photos, selfies, portraits).
# Supabase → Project Settings → API → service_role. SERVER ONLY: this key bypasses
# storage authorization entirely. Reads are served as short-lived signed URLs.
# Unset ⇒ storage runs in SIMULATION and no image is ever persisted.
# SUPABASE_URL is derived from DATABASE_URL's <role>.<projectref> when omitted.
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_URL="https://<projectref>.supabase.co"
# Run `npm run storage:init` once to create the private bucket.

# Scoring engines (shared with the Hub deployment)
ORIGINATION_SCORER_URL="https://birgen-origination-engine-....run.app"   # v2 bespoke (Micromart)
ORIGINATION_POOLED_URL="https://birgen-pooled-engine-....run.app"        # v3 pooled (everyone else)
SCORER_V1_URL="https://birgen-ai-agent-....run.app/"                      # v1 behavioral monitor

# Platform email (staff/org onboarding; per-org SMTP is an Enterprise vault entry)
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BirgenAI LMS <no-reply@birgenai.com>"

# Default SMS provider for native orgs (per-org override in the vault)
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID=""

# Cron/job auth (outcome-backfill runs daily 03:00 UTC via vercel.json)
CRON_SECRET=""

# ServiceSuite hook auth (bridged-mode server-to-server)
SERVICESUITE_HOOK_SECRET=""

# ── Bridged-mode ServiceSuite connections (Phase 1; moves into the per-org
#    encrypted vault in Phase 2). Same .NET-style strings ServiceSuite uses.
SERVICESUITE_CONN_MICROMART=""
SERVICESUITE_CONN_AXE=""
SERVICESUITE_CONN_BUYSIMU=""
# Optional per-org EntityId overrides:
# SERVICESUITE_ENTITYID_MICROMART=3002  SERVICESUITE_ENTITYID_AXE=3003

# Bridged posting (sp_InsertLoan into the BirgenAI workflow)
LMS_POSTING_ENABLED="false"          # true only after the lender's workflow exists
LMS_SERVICESUITE_CREATED_BY=""       # UserMaster.ID of the BirgenAI service account
LMS_SERVICESUITE_CHANNEL="7"         # ChannelUsed tag for portal-originated loans
SCORE_WRITEBACK_ENABLED="false"      # write BirgenAI score to Borrowers.CreditScore

# Behavioral (v1) scorer override; defaults to the deployed Cloud Run URL
# CREDIT_SCORER_URL=""

# Platform administration (org activation, plan assignment) — BirgenAI-side bearer secret
PLATFORM_ADMIN_SECRET=""

# ── Centralised payments (the BirgenAI wallet) ────────────────────────────────
# PLATFORM RULE: every payment made TO BirgenAI — from birgenai.com and from every
# subdomain, this app included — settles through the Hub wallet. One Till, one
# ledger, one receipt. This app therefore has NO Daraja client for its own
# subscriptions; it deep-links to the Hub's /transact and reads the result back.
# (The per-org Daraja creds in the vault are a different thing entirely: they move
# the LENDER's money to and from their own borrowers.)
#
# LMS_BILLING_SECRET does double duty, and must hold the SAME value as the variable
# of the same name in the Hub deployment:
#   • it signs the short-lived checkout token that tells the Hub "this admin may buy
#     this package for this org" — the Hub cannot know that, our staff are in OUR db;
#   • it authenticates GET /api/lms/subscription when we read payment state back.
#
# Unset ⇒ checkout is unavailable and the sync is a no-op, so local subscription
# state stands and the demo org and local development keep working with no Hub.
HUB_BILLING_URL="https://birgenai.com"
LMS_BILLING_SECRET=""

# ── Maps & routing (Field Ops → Route Map) ────────────────────────────────────
# Google Maps Platform. TWO APIs must be enabled on the key's project:
#   • Maps JavaScript API   — the basemap itself
#   • Directions API        — the route, and duration_in_traffic (live Nairobi traffic)
#
# THIS KEY IS PUBLIC BY CONSTRUCTION. Maps JS authenticates from the browser, so the
# key ships in the client bundle — there is no server-side variant of a rendered map.
# Google's answer, and the ONLY answer, is an HTTP-referrer restriction:
#
#   Restrict to: lms.birgenai.com/*, *.birgenai.com/*, localhost:3000/*
#   Restrict to APIs: Maps JavaScript API + Directions API — nothing else.
#
# ⚠ CREATE A NEW KEY FOR THIS. Do NOT reuse GOOGLE_API_KEY / GOOGLE_CLOUD_API_KEY from
# the Hub or the agent projects: those can call Gemini, and a Gemini-capable key pasted
# here would be published in the bundle for anyone to bill to the project.
#
# Unset ⇒ the Route Map says so on screen and does not load. Nothing else is affected.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ── Identity / KYC — THREE PROVIDERS, THREE JOBS (Smile ID is gone) ───────────
# The pipeline is: read the card → confirm the human exists → confirm it is them.
#
#   1. GOOGLE CLOUD VISION reads the ID front (TEXT_DETECTION).
#      SERVER-SIDE ONLY — never NEXT_PUBLIC. Restrict the key to the Cloud Vision API.
GOOGLE_CLOUD_API_KEY=""
#
#   2. IPRS (Spinmobile) confirms the ID number against the national registry, and
#      THE NAME ON THE CARD MUST BE THE NAME THE REGISTRY HOLDS FOR IT. That is the
#      fraud gate — see IPRS_* above.
#
#   3. AWS REKOGNITION compares the selfie to the portrait printed on the document.
#      Google Cloud Vision CANNOT do this — it has no face-comparison endpoint, by
#      policy — which is why identity deliberately spans two clouds.
#      IAM user needs only: rekognition:CompareFaces, rekognition:DetectFaces.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-1"
#
# Each leg is simulation-first and INDEPENDENT: whichever credentials are present go
# live, the rest stay simulated, and the KYC screen names which is which per leg
# rather than showing one misleading "DEMO MODE" badge.

# ── M-Pesa callbacks ─────────────────────────────────────────────────────────
# ⚠ REQUIRED FOR STK TO WORK AT ALL. Daraja refuses a CallBackURL that is not a
# public HTTPS address — it answers "Bad Request - Invalid CallBackURL" and the
# customer's phone never rings. Without this, publicBase() falls back to
# NEXTAUTH_URL, which locally is http://localhost:3000, and every push fails.
# Use the CANONICAL host (microeazy.), not lms. — lms. only rewrites onto
# /suite/lms/login, so the callback must name the deployment itself.
PUBLIC_BASE_URL="https://microeazy.servicesuitecloud.com"

# ── The connected suite (Phase 7 federation) ─────────────────────────────────
# The parent domain the staff session cookie is scoped to. Setting this is what
# makes ONE sign-in valid across every subdomain — and what makes signing out
# sign you out of all of them. Leave BLANK in development and on preview
# deployments: ".localhost" is rejected by browsers, and ".vercel.app" would
# share the cookie with every other tenant of that domain.
SUITE_COOKIE_DOMAIN=""               # production: servicesuitecloud.com

# Move a system onto its own origin. Unset = it keeps its in-app route, so the
# suite can be split out ONE SYSTEM AT A TIME with no code change and no flag
# day. A malformed value falls back to the in-app route rather than a dead link.
# The subdomain labels below are reserved automatically (src/lib/suite/hosts.ts),
# so no lender can sign up and take one.
SUITE_LMS_ORIGIN=""                  # https://lms.servicesuitecloud.com
SUITE_PORTAL_ORIGIN=""               # https://microeazy.servicesuitecloud.com
# The Analytics Studio. NOTE: analytics.servicesuitecloud.com already works
# because src/proxy.ts rewrites that host onto /analytics inside this same
# deployment — which is deliberate, so the studio inherits auth, tenancy, the
# vault and RBAC rather than duplicating the two surfaces where a multi-tenant
# bug becomes a cross-lender leak. Set this only when the studio genuinely moves
# to its own deployment.
SUITE_ANALYTICS_ORIGIN=""            # https://analytics.servicesuitecloud.com
SUITE_HR_ORIGIN=""                   # https://peoplehub.servicesuitecloud.com
SUITE_ACCOUNTING_ORIGIN=""           # https://ledgerly.servicesuitecloud.com
SUITE_CALLCENTER_ORIGIN=""           # https://connectdesk.servicesuitecloud.com
# Every satellite must share NEXTAUTH_SECRET with this deployment — that shared
# secret is what lets it verify a BirgenAI ID issued here.

# ── The SQL relay — REQUIRED ON VERCEL, unset on the tailnet ─────────────────
# Micromart's SQL Server is at 100.72.35.56, a Tailscale CGNAT address with NO
# internet route. A cloud deployment cannot open a socket to it under ANY
# configuration, so a relay on a tailnet host holds the connection and answers
# signed query requests. See src/lib/enterprise/relay.ts.
#
#   on the relay host:   npm run relay   then   tailscale funnel 8787
#   verify from anywhere: npm run test:relay
#
# Leave the URL BLANK in local development: this workstation is on the tailnet,
# so the direct TDS path is correct and one hop faster.
#
# NOTE WHAT IS ABSENT ON VERCEL. With a relay configured, isOrgConfigured() is
# satisfied by the relay, so SERVICESUITE_CONN_MICROMART does NOT need to be set
# there — Micromart's database password never leaves the tailnet.
SERVICESUITE_RELAY_URL=""            # https://<host>.<tailnet>.ts.net
SERVICESUITE_RELAY_SECRET=""         # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Relay-host-only settings (never set these on Vercel):
# SQL_RELAY_PORT=8787
# SQL_RELAY_HOST=127.0.0.1
# SQL_RELAY_ALLOW_WRITES=false       # demo posture: writes refused at the socket

# ── The CRB relay — REQUIRED ANYWHERE THE IP IS NOT WHITELISTED ──────────────
# A DIFFERENT PROBLEM FROM THE SQL RELAY ABOVE, WITH THE SAME SHAPE OF FIX.
# There, the destination had no internet route. Here it does — Metropol simply
# refuses to answer anyone but a registered source IP, and drops the request at
# their edge with NO response, NO api_code and nothing in a log. It looks in the
# console exactly like the bureau being down.
#
# Registered addresses (whitelist form, 27 Aug 2026):
#   102.214.69.233    the IIS production server (servicesuitecloud.com) — where
#                     the native C# portal already calls Metropol from.
#   102.210.148.110   the MicroMart site.
#
# WHICH TAILNET NODE PRESENTS WHICH IS NOT OBVIOUS — verify, do not assume:
#   lms       reaches port 22225 (proven). Its egress address is not yet on
#             record; the relay's boot line reports it.
#   services  egresses 102.210.148.124, which is NOT on the form, and the port
#             test has not been run there. Do not infer that it works from it
#             being in the same /24 as .110.
#
# The only trustworthy check, run ON the host in question:
#     Test-NetConnection api.metropol.co.ke -Port 22225
# Port 22225 does not open for unregistered addresses at all, so a completed
# handshake is proof and a hang is proof of the opposite.
#
# Neither Vercel (rotating egress pool) nor the office link (Safaricom DHCP,
# 41.90.128.0/17 — was .172.115, now .173.56) can be on that list, so those
# callers egress through a relay on one of the two hosts above.
#
#   on the relay host:    node crb-relay.mjs   then   tailscale funnel 8788
#                         (it prints its own public IP on boot and says whether
#                          that address is on the whitelist — check that first)
#   in this repo:         npm run relay:crb    (same thing)
#   verify from anywhere: npm run test:crb:prod
#
# THE RELAY HOST NEEDS NODE AND NOTHING ELSE. scripts/crb-relay.mjs imports only
# node:http, node:crypto and node:fs — no npm install, no tsx, no checkout of
# this repo. Copy that ONE file to the box, set CRB_RELAY_SECRET, run it. That
# is deliberate: the whitelisted host is MicroMart's SQL Server, which should
# not be growing a JavaScript toolchain.
#
# LEAVE BLANK ON A WHITELISTED HOST. There the direct path is correct and one
# hop faster; the relay would only add a round trip to reach the same place.
# The Metropol key pair is NOT needed on the relay host — keys stay in the
# caller's vault and pass through as opaque headers.
#
# THE VALUE IS DIFFERENT ON VERCEL THAN IT IS HERE, and getting that wrong is the
# quietest failure in this whole path. A tailnet address (100.64.0.0/10) is CGNAT
# space: reachable from any machine ON the tailnet, unroutable from the public
# internet. So a laptop can run `npm run test:crb:prod` green through
# http://100.92.236.116:8788 while every bureau call from the LIVE site dies at
# the relay hop, because Vercel functions are not tailnet members.
#
#   tailnet machine   CRB_RELAY_URL=http://100.92.236.116:8788   (lms, direct)
#   Vercel            CRB_RELAY_URL=https://lms.<tailnet>.ts.net (needs `tailscale funnel 8788` ON lms)
#
# The funnel URL works from both, so prefer it if you want one value.
CRB_RELAY_URL=""                     # https://<host>.<tailnet>.ts.net
CRB_RELAY_SECRET=""                  # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Relay-host-only settings (never set these on Vercel):
# CRB_RELAY_PORT=8788
# CRB_RELAY_HOST=127.0.0.1

# ── Metropol subscription — THE PORT IS PER-SUBSCRIPTION, AND TEST ≠ PROD ────
# Host and version are shared; only the port differs. Production keys pointed at
# the TEST port authenticate and then answer E003 "Not Authorized" on every
# report — which reads as a provisioning failure and is really the wrong port.
# METROPOL_HOST=api.metropol.co.ke
# METROPOL_VERSION=v2_1
# METROPOL_PORT=22225                # PRODUCTION
# METROPOL_TEST_PORT=5555            # test subscription (used by --testbed)
